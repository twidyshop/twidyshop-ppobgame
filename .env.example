# Payment: required
CHECKOUT_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Supplier API credentials: required for the relevant suppliers
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
HAYBI_USERNAME=
HAYBI_API_KEY=

# Admin credentials: required; there are no default credentials
ADMIN_USER=
ADMIN_PASS=

# Optional email receipts
RESEND_API_KEY=

# Optional shared secrets for supplier callbacks.
# Configure the same secret/header with the provider before enabling its callback.
DIGIFLAZZ_WEBHOOK_SECRET=
HAYBI_WEBHOOK_SECRET=

PORT=3000
