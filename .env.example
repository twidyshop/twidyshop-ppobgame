# Payment: required
CHECKOUT_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Supplier API credentials: required for the relevant suppliers
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=

# Admin credentials: required; there are no default credentials
ADMIN_USER=
ADMIN_PASS=

# Optional email receipts
RESEND_API_KEY=

# Optional shared secret for Digiflazz callback.
DIGIFLAZZ_WEBHOOK_SECRET=

PORT=3000
